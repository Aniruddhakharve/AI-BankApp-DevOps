# -------------------------------
# STAGE 1 : BUILD THE APPLICATION
# -------------------------------

# Use a Java Development Kit (JDK) image.
# JDK contains tools required to compile/build Java applications.
# We name this stage "builder" so we can copy files from it later.
FROM eclipse-temurin:21-jdk-jammy AS builder

# Set the working directory inside the container.
# All commands after this will run inside /app.
WORKDIR /app

# Copy all project files from the host machine into the container.
# This includes:
# - source code (src/)
# - Maven wrapper (mvnw)
# - pom.xml
COPY . .

# Fix Windows line ending issue (\r) that sometimes breaks scripts in Linux.
# Then make the Maven wrapper executable.
# After that, build the Java application.
#
# ./mvnw clean package
# - clean   : removes old build files
# - package : compiles code and creates a JAR file
#
# -DskipTests : skip running tests (faster Docker builds)
# -B           : run Maven in batch mode (no interactive prompts)
RUN sed -i 's/\r$//' mvnw && chmod +x mvnw && ./mvnw clean package -DskipTests -B


# ---------------------------------
# STAGE 2 : RUN THE APPLICATION
# ---------------------------------

# Use a smaller Java Runtime Environment (JRE) image.
# JRE can run Java applications but cannot build them.
# This keeps the final container smaller and more secure.
FROM eclipse-temurin:21-jre-jammy

# Set working directory again in the runtime container.
WORKDIR /app

# Copy the compiled JAR file from the builder stage.
# We do NOT copy source code or build tools, only the final application.
#
# Source: builder stage → /app/target/*.jar
# Destination: current container → /app/app.jar
COPY --from=builder /app/target/*.jar app.jar

# Tell Docker that this container listens on port 8080.
# This is only documentation for Docker.
# The actual port mapping happens when running the container.
EXPOSE 8080

# Command that will run when the container starts.
# It launches the Spring Boot application using Java.
#
# Equivalent command:
# java -jar app.jar
ENTRYPOINT ["java","-jar","app.jar"]